{
  "manifest_version": 3,
  "name": "Draggable Video Pop Out: Floating Picture in Picture Player",
  "version": "2.0",
  "description": "Pop out any video into a floating, resizable player that stays put while you scroll, with picture in picture in one click.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "pop-out-video": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Pop out the video under the cursor, or put it back"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}
